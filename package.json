{
  "name": "resume-micro-app",
  "version": "1.0.0",
  "private": true,
  "description": "Bauhaus-styled resume mini-program built with Taro 4",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": ["last 3 versions", "Android >= 4.1", "ios >= 8"],
  "dependencies": {
    "@tarojs/components": "4.0.9",
    "@tarojs/react": "4.0.9",
    "@tarojs/runtime": "4.0.9",
    "@tarojs/taro": "4.0.9",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@tarojs/cli": "4.0.9",
    "@tarojs/helper": "4.0.9",
    "@tarojs/plugin-framework-react": "4.0.9",
    "@tarojs/webpack5-runner": "4.0.9",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "sass": "^1.77.0",
    "typescript": "^5.0.4"
  }
}
